<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TtsStreamSupporter.ViewModels"
             xmlns:models="using:TtsStreamSupporter.Models"
             x:Class="TtsStreamSupporter.Views.IndividualVoicesTab"
             x:DataType="vm:IndividualVoicesTabViewModel">

    <UserControl.Styles>

        <!-- Общий стиль для карточек-секций -->
        <Style Selector="Border.section">
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="BorderBrush" Value="#E2E2E2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="BoxShadow" Value="0 2 10 0 #14000000"/>
        </Style>

        <!-- Заголовок секции -->
        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Margin" Value="2,0,0,10"/>
        </Style>

        <!-- Карточка элемента списка -->
        <Style Selector="Border.item">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E6E6E6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="BoxShadow" Value="0 1 3 0 #0F000000"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>

        <!-- Голоса: выделение / наведение -->
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter Border.item">
            <Setter Property="Background" Value="#EEF6DA"/>
            <Setter Property="BorderBrush" Value="#B8D24A"/>
        </Style>

        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter Border.item">
            <Setter Property="Background" Value="#F4F9E8"/>
        </Style>

        <!-- Поле поиска -->
        <Style Selector="TextBox.search">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DADADA"/>
        </Style>

        <!-- Тумблер вкл/выкл -->
        <Style Selector="ToggleButton.enableToggle">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style Selector="ToggleButton.enableToggle:checked">
            <Setter Property="Background" Value="#43A047"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Content" Value="Включен"/>
        </Style>

        <Style Selector="ToggleButton.enableToggle:unchecked">
            <Setter Property="Background" Value="#BDBDBD"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Content" Value="Отключен"/>
        </Style>

    </UserControl.Styles>

    <Grid RowDefinitions="*,*" ColumnDefinitions="*">

        <!-- Голоса и настройки -->

        <Border Grid.Row="0" Classes="section">
            <DockPanel>

                <TextBlock DockPanel.Dock="Top"
                           Classes="sectionTitle"
                           Text="🎙️ Голоса и настройки"/>

                <ListBox ItemsSource="{Binding IndividualVoices}"
                         Background="Transparent"
                         HorizontalAlignment="Stretch"
                         VerticalAlignment="Stretch"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.IsScrollInertiaEnabled="True">

                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:IndividualVoiceSettings">

                            <Border Classes="item" MaxHeight="500">

                                <Grid ColumnDefinitions="130,*,Auto"
                                      RowDefinitions="Auto,Auto">

                                    <TextBlock Grid.Row="0"
                                               Grid.Column="0"
                                               Grid.RowSpan="2"
                                               Text="{Binding Name}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#2E2E2E"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"
                                               Margin="0,5,8,0"/>

                                    <Grid Grid.Row="0"
                                          Grid.Column="1"
                                          ColumnDefinitions="Auto,*,Auto"
                                          Margin="3,1">

                                        <TextBlock Grid.Column="0"
                                                   Text="Громкость"
                                                   FontSize="11"
                                                   Foreground="#666666"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,5,0"/>

                                        <Slider Grid.Column="1"
                                                Minimum="0"
                                                Maximum="100"
                                                Value="{Binding Volume}"
                                                Height="20"
                                                MinWidth="100"
                                                HorizontalAlignment="Stretch"/>

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Volume, StringFormat={}{0:0}}"
                                                   FontSize="11"
                                                   Width="25"
                                                   TextAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   Margin="5,0,0,0"/>
                                    </Grid>

                                    <Grid Grid.Row="1"
                                          Grid.Column="1"
                                          ColumnDefinitions="Auto,*,Auto"
                                          Margin="3,1">

                                        <TextBlock Grid.Column="0"
                                                   Text="Скорость"
                                                   FontSize="11"
                                                   Foreground="#666666"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,5,0"/>

                                        <Slider Grid.Column="1"
                                                Minimum="-10"
                                                Maximum="10"
                                                Value="{Binding Speed}"
                                                Height="20"
                                                MinWidth="100"
                                                HorizontalAlignment="Stretch"/>

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Speed, StringFormat={}{0:0}}"
                                                   FontSize="11"
                                                   Width="25"
                                                   TextAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   Margin="5,0,0,0"/>
                                    </Grid>

                                    <ToggleButton Grid.Row="0"
                                                  Grid.RowSpan="2"
                                                  Grid.Column="2"
                                                  Classes="enableToggle"
                                                  IsChecked="{Binding IsEnabled}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="8,0,0,0"
                                                  Padding="8,4"
                                                  FontSize="12"
                                                  MinWidth="70"/>

                                </Grid>

                            </Border>

                        </DataTemplate>
                    </ListBox.ItemTemplate>

                </ListBox>

            </DockPanel>
        </Border>


        <!-- Индивидуальные голоса -->

        <Border Grid.Row="1" Classes="section">
            <DockPanel>

                <TextBlock DockPanel.Dock="Top"
                           Classes="sectionTitle"
                           Text="🔗 Индивидуальные голоса"/>

                <TextBox DockPanel.Dock="Top"
                         Classes="search"
                         PlaceholderText="Поиск по платформе, нику или голосу..."
                         Text="{Binding SearchText, Mode=TwoWay}">
                    <TextBox.InnerLeftContent>
                        <TextBlock Text="🔍"
                                   Margin="8,0,4,0"
                                   VerticalAlignment="Center"
                                   Opacity="0.6"/>
                    </TextBox.InnerLeftContent>
                </TextBox>

                <ListBox ItemsSource="{Binding FilteredIndividualVoiceAssignments}"
                         Background="Transparent"
                         HorizontalAlignment="Stretch"
                         VerticalAlignment="Stretch"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.IsScrollInertiaEnabled="True">

                    <ListBox.Styles>
                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter Border.item">
                            <Setter Property="Background" Value="#DCEBFA"/>
                            <Setter Property="BorderBrush" Value="#5A9CDB"/>
                        </Style>
                        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter Border.item">
                            <Setter Property="Background" Value="#EEF5FC"/>
                        </Style>
                    </ListBox.Styles>

                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:IndividualVoiceAssignment">

                            <Border Classes="item">

                                <Grid ColumnDefinitions="100,*,*">

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Platform}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#2E2E2E"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Username}"
                                               FontSize="13"
                                               Foreground="#555555"
                                               VerticalAlignment="Center"
                                               Margin="10,0"/>

                                    <ComboBox Grid.Column="2"
                                              CornerRadius="8"
                                              ItemsSource="{Binding $parent[ListBox].DataContext.EnabledVoices}"
                                              SelectedItem="{Binding SelectedVoice, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch"
                                              MinWidth="180">

                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:IndividualVoiceSettings">
                                                <TextBlock Text="{Binding Name}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>

                                    </ComboBox>

                                </Grid>

                            </Border>

                        </DataTemplate>
                    </ListBox.ItemTemplate>

                </ListBox>

            </DockPanel>
        </Border>

    </Grid>

</UserControl>
