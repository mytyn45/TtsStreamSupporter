<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:TtsStreamSupporter.ViewModels"
        xmlns:views="using:TtsStreamSupporter.Views"
        mc:Ignorable="d"
        d:DesignWidth="900"
        d:DesignHeight="700"
        x:Class="TtsStreamSupporter.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="TtsStreamSupporter"
        Width="900"
        Height="720"
        MinWidth="850"
        MinHeight="550">
    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>
    <Grid RowDefinitions="*,Auto"
          Margin="10">
        <!-- Вкладки -->
        <TabControl Grid.Row="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">
            <TabControl.Styles>
                <Style Selector="TabItem">
                    <Setter Property="Foreground" Value="#222222"/>
                    <Setter Property="FontSize" Value="15"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="Margin" Value="0,0,4,0"/>
                    <Setter Property="Padding" Value="14,7"/>
                    <Setter Property="CornerRadius" Value="6,6,0,0"/>
                    <Setter Property="BorderThickness" Value="1,1,1,0"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                </Style>
                <Style Selector="TabItem:selected">
                    <Setter Property="Background" Value="#FFEFF5DC"/>
                    <Setter Property="BorderBrush" Value="#D4E4B8"/>
                    <Setter Property="Foreground" Value="#1A3300"/>
                </Style>
            </TabControl.Styles>
            <TabItem Header="Connection">
                <ScrollViewer>
                    <views:ConnectionsTab DataContext="{Binding ConnectionsTab}"/>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="TTS">
                <views:TtsTab DataContext="{Binding TtsTab}"/>
            </TabItem>
            <TabItem Header="Логи">
                <views:LogsTab DataContext="{Binding LogsTab}"/>
            </TabItem>
            <TabItem Header="Голоса">
                <views:IndividualVoicesTab DataContext="{Binding IndividualVoicesTab}"/>
            </TabItem>
            <TabItem Header="Ntts">
                <ScrollViewer>
                    <views:NttsTab DataContext="{Binding NttsTab}"/>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        <!-- Нижняя часть -->
        <Grid Grid.Row="1"
              Margin="0,10,0,0"
              ColumnDefinitions="Auto,*,Auto">
            <!-- Checkbox'ы слева: Привязка голосов и Включить Ntts под ней -->
            <StackPanel Grid.Column="0"
                        Orientation="Vertical"
                        Spacing="4"
                        VerticalAlignment="Center">
                <CheckBox IsChecked="{Binding IndividualVoicesEnabled}"
                          Content="Привязка голосов"/>
                <CheckBox IsChecked="{Binding CheckBoxNttsVoicesIsEnabled}"
                          Content="Включить Ntts"/>
            </StackPanel>
            <!-- Предупреждения в центре в самом низу -->
            <ItemsControl Grid.Column="1"
                          ItemsSource="{Binding ActiveWarnings}"
                          Margin="15,0"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{Binding BackgroundBrush}"
                                CornerRadius="6"
                                Padding="10,5"
                                Margin="4"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="6"
                                        VerticalAlignment="Center">
                                <TextBlock Text="⚠"
                                           FontWeight="Bold"
                                           FontSize="13"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding ForegroundBrush}"/>
                                <TextBlock Text="{Binding Message}"
                                           FontWeight="SemiBold"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding ForegroundBrush}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- Статусы подключений справа с цветным фоном -->
            <ItemsControl Grid.Column="2"
                          ItemsSource="{Binding Connections}"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"
                                    Spacing="10"
                                    VerticalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{Binding BackgroundBrush}"
                                CornerRadius="6"
                                Padding="10,5"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Vertical"
                                        Spacing="6"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}"
                                           FontWeight="Bold"
                                           Foreground="{Binding ForegroundBrush}"/>
                                <TextBlock Text="{Binding StatusText}"
                                           Foreground="{Binding ForegroundBrush}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Grid>
</Window>