<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TtsStreamSupporter.ViewModels"
             x:Class="TtsStreamSupporter.Views.LogsTab"
             x:DataType="vm:LogsTabViewModel">

    <Grid RowDefinitions="*,Auto" Margin="5">
        <Border Grid.Row="0" BorderBrush="Black" BorderThickness="1" Margin="5">
            <Grid RowDefinitions="Auto,*">

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding ListBoxLogs}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         HorizontalAlignment="Stretch"
                         VerticalAlignment="Stretch"/>
            </Grid>
        </Border>
        <Button Grid.Row="1"
                Content="Логи"
                Command="{Binding OpenLogsFolder}"
                VerticalAlignment="Center"
                HorizontalAlignment="Right"
                Margin="5"/>
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="5">
            <Button Content="Настройки"
                    ToolTip.Tip="Открыть папку с настройками (AppData)"
                    Command="{Binding OpenSettingsFolder}"
                    VerticalAlignment="Center"/>
            <Button Content="Логи"
                    ToolTip.Tip="Открыть папку с логами"
                    Command="{Binding OpenLogsFolder}"
                    VerticalAlignment="Center"/>
        </StackPanel>
    </Grid>

</UserControl>