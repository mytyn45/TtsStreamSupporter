<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TtsStreamSupporter.ViewModels"
             x:Class="TtsStreamSupporter.Views.TtsTab"
             x:DataType="vm:TtsTabViewModel">

    <UserControl.Styles>
        <!-- Карточка-секция -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="BorderBrush" Value="#E2E2E2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

        <!-- Заголовок карточки -->
        <Style Selector="TextBlock.cardHeader">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>

        <!-- Подзаголовок/метка -->
        <Style Selector="TextBlock.subHeader">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#555555"/>
        </Style>

        <!-- Подвкладки списков -->
        <Style Selector="TabControl.subTabs TabItem">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="CornerRadius" Value="6,6,0,0"/>
            <Setter Property="BorderThickness" Value="1,1,1,0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="TabControl.subTabs TabItem:selected">
            <Setter Property="Background" Value="#EFF5DC"/>
            <Setter Property="BorderBrush" Value="#D4E4B8"/>
            <Setter Property="Foreground" Value="#1A3300"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer x:Name="TtsScrollViewer"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  IsScrollInertiaEnabled="True">

        <Grid ColumnDefinitions="360,*" ColumnSpacing="10" Margin="8">

            <!-- ================= ЛЕВАЯ КОЛОНКА (Озвучка, Эффекты, Команды, Piper) ================= -->
            <StackPanel Grid.Column="0" Spacing="8">

                <!-- Карточка 1: Голос и Звуковые эффекты -->
                <Border Classes="card">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Озвучка и эффекты" Classes="cardHeader"/>

                        <!-- Выбор голоса -->
                        <ComboBox ItemsSource="{Binding ComboBoxItemSourceInstalledVoices}"
                                  SelectedItem="{Binding ComboBoxSelectedItemInstalledVoices}"
                                  ToolTip.Tip="{Binding ComboBoxSelectedItemInstalledVoices}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- Слайдеры голоса в компактном Grid -->
                        <Grid ColumnDefinitions="75,*,35" RowDefinitions="Auto,Auto" RowSpacing="4" ColumnSpacing="6">
                            <!-- Громкость -->
                            <Label Grid.Row="0" Grid.Column="0" Content="Громкость" VerticalAlignment="Center" Padding="0"/>
                            <Slider Grid.Row="0" Grid.Column="1"
                                    ToolTip.Tip="Громкость (0-100)"
                                    Value="{Binding SliderSingleVoiceVolume}"
                                    Minimum="0" Maximum="100"/>
                            <TextBlock Grid.Row="0" Grid.Column="2"
                                       Text="{Binding SliderSingleVoiceVolume}"
                                       VerticalAlignment="Center" HorizontalAlignment="Right"
                                       FontWeight="SemiBold" FontSize="12"/>

                            <!-- Скорость -->
                            <Label Grid.Row="1" Grid.Column="0" Content="Скорость" VerticalAlignment="Center" Padding="0"/>
                            <Slider Grid.Row="1" Grid.Column="1"
                                    ToolTip.Tip="Скорость (-10 - +10)"
                                    Value="{Binding SliderSingleVoiceSpeed}"
                                    Minimum="-10" Maximum="10"/>
                            <TextBlock Grid.Row="1" Grid.Column="2"
                                       Text="{Binding SliderSingleVoiceSpeed}"
                                       VerticalAlignment="Center" HorizontalAlignment="Right"
                                       FontWeight="SemiBold" FontSize="12"/>
                        </Grid>

                        <Separator Height="1" Background="#E6E6E6" Margin="0,2"/>

                        <!-- Звуковые эффекты -->
                        <TextBlock Text="Звуковые эффекты" Classes="subHeader"/>

                        <Grid ColumnDefinitions="85,*,40" RowDefinitions="Auto,Auto" RowSpacing="4" ColumnSpacing="6">
                            <!-- Компрессор -->
                            <CheckBox Grid.Row="0" Grid.Column="0" Content="Компрессор"
                                      IsChecked="{Binding CheckBoxNormalizationTts}"
                                      Padding="4,0,0,0" VerticalAlignment="Center"/>
                            <Slider Grid.Row="0" Grid.Column="1"
                                    ToolTip.Tip="Сила компрессора (0-10)"
                                    Value="{Binding SliderCompressorPower}"
                                    Minimum="0" Maximum="10"/>
                            <TextBlock Grid.Row="0" Grid.Column="2"
                                       Text="{Binding SliderCompressorPower}"
                                       VerticalAlignment="Center" HorizontalAlignment="Right"
                                       FontWeight="SemiBold" FontSize="12"/>

                            <!-- Усиление -->
                            <Label Grid.Row="1" Grid.Column="0" Content="Усиление" VerticalAlignment="Center" Padding="0"/>
                            <Slider Grid.Row="1" Grid.Column="1"
                                    ToolTip.Tip="Множитель громкости (1x - 10x)"
                                    Value="{Binding SliderMasterVolumeMultiplier}"
                                    Minimum="1" Maximum="10"
                                    SmallChange="0.5" LargeChange="1"/>
                            <TextBlock Grid.Row="1" Grid.Column="2"
                                       Text="{Binding MasterVolumeMultiplierText}"
                                       VerticalAlignment="Center" HorizontalAlignment="Right"
                                       FontWeight="SemiBold" FontSize="12"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Карточка 2: Команды чата -->
                <Border Classes="card">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="Команды чата" Classes="cardHeader" VerticalAlignment="Center"/>
                            <CheckBox Grid.Column="1" Content="Пропуск вкл."
                                      IsChecked="{Binding CheckBoxAllowSkipMessages}"
                                      VerticalAlignment="Center" Padding="4,0,0,0"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,110" RowDefinitions="Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="8">
                            <Label Grid.Row="0" Grid.Column="0" Content="Не озвучивать с" VerticalAlignment="Center" Padding="0"/>
                            <TextBox Grid.Row="0" Grid.Column="1"
                                     Text="{Binding DoNotTtsIfStartWith}"
                                     PlaceholderText="!" Height="28"/>

                            <Label Grid.Row="1" Grid.Column="0" Content="Пропуск 1 сообщ." VerticalAlignment="Center" Padding="0"/>
                            <TextBox Grid.Row="1" Grid.Column="1"
                                     Text="{Binding SkipMessage}"
                                     PlaceholderText="!c" Height="28"/>

                            <Label Grid.Row="2" Grid.Column="0" Content="Пропуск всех сообщ." VerticalAlignment="Center" Padding="0"/>
                            <TextBox Grid.Row="2" Grid.Column="1"
                                     Text="{Binding SkipAllMessages}"
                                     PlaceholderText="!cв" Height="28"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Карточка 3: Piper голоса -->
                <Border Classes="card">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Piper голоса" Classes="cardHeader"/>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{Binding ComboBoxItemSourceAvailablePiperVoices}"
                                      SelectedItem="{Binding SelectedPiperVoiceToDownload}"
                                      IsEnabled="{Binding !IsPiperDownloading}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Column="1"
                                    Content="Скачать"
                                    Command="{Binding ButtonDownloadPiperVoice}"
                                    IsEnabled="{Binding !IsPiperDownloading}"/>
                        </Grid>

                        <!-- Прогресс загрузки -->
                        <StackPanel Spacing="2" IsVisible="{Binding IsPiperDownloadProgressVisible}">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding PiperDownloadStatusText}"
                                           FontSize="11"
                                           Foreground="{Binding PiperDownloadStatusBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding PiperDownloadProgressText}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </Grid>
                            <ProgressBar Value="{Binding PiperDownloadProgressValue}"
                                         Minimum="0" Maximum="100"
                                         Height="4"
                                         CornerRadius="2"
                                         IsIndeterminate="{Binding IsPiperDownloadIndeterminate}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>

            <!-- ================= ПРАВАЯ КОЛОНКА (Списки: Замена слов, Замена символов, Чёрный список) ================= -->
            <Border Grid.Column="1" Classes="card" Padding="8">
                <TabControl Classes="subTabs">

                    <!-- Вкладка 1: Замена слов -->
                    <TabItem Header="Замена слов">
                        <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="6" Margin="0,6,0,0">
                            <!-- Форма ввода -->
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto,*,Auto,Auto" ColumnSpacing="6">
                                <TextBox Grid.Column="0"
                                         PlaceholderText="Слово"
                                         Text="{Binding TextBoxWordToReplace}"/>
                                <Button Grid.Column="1"
                                        Content="✕"
                                        ToolTip.Tip="Очистить поля"
                                        Command="{Binding ButtonClearWordReplacementInputs}"
                                        VerticalAlignment="Center"
                                        Padding="8,5"/>
                                <TextBox Grid.Column="2"
                                         PlaceholderText="Замена"
                                         Text="{Binding TextBoxReplacementWord}"/>
                                <Button Grid.Column="3"
                                        Content="Добавить"
                                        Command="{Binding ButtonAddWordReplacement}"/>
                                <Button Grid.Column="4"
                                        Content="Удалить"
                                        Command="{Binding ButtonRemoveWordReplacement}"/>
                            </Grid>

                            <!-- Оповещение о совпадении -->
                            <Border Grid.Row="1"
                                    Background="#E3F2FD"
                                    BorderBrush="#2196F3"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="6,3"
                                    IsVisible="{Binding IsExactMatchFound}">
                                <TextBlock Text="Такое слово уже есть в правилах"
                                           Foreground="#1976D2"
                                           FontWeight="Bold"
                                           FontSize="12"/>
                            </Border>

                            <!-- Заголовки колонок -->
                            <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="4">
                                <TextBlock Grid.Column="0" Text="Слово" FontWeight="SemiBold" Opacity="0.7" Margin="6,0"/>
                                <TextBlock Grid.Column="1" Text="Замена" FontWeight="SemiBold" Opacity="0.7" Margin="6,0"/>
                            </Grid>

                            <!-- Список -->
                            <Border Grid.Row="3"
                                    BorderBrush="#E0E0E0" BorderThickness="1"
                                    CornerRadius="4"
                                    ClipToBounds="True">
                                <ListBox ItemsSource="{Binding FilteredWordReplacements}"
                                         SelectedItem="{Binding SelectedWordReplacementItem}"
                                         DoubleTapped="OnWordReplacementsDoubleTapped"
                                         MinHeight="280"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.IsScrollInertiaEnabled="True">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:WordReplacementItemViewModel">
                                            <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
                                                <!-- Слово -->
                                                <Border Grid.Column="0"
                                                        Background="{Binding WordBackground}"
                                                        BorderBrush="{Binding WordBorderBrush}"
                                                        BorderThickness="{Binding WordBorderThickness}"
                                                        CornerRadius="4"
                                                        Padding="6,3">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding Word}"
                                                                   FontWeight="{Binding WordFontWeight}"
                                                                   Foreground="{Binding WordForeground}"
                                                                   VerticalAlignment="Center"
                                                                   TextWrapping="Wrap"/>
                                                        <Border Grid.Column="1"
                                                                IsVisible="{Binding IsWordExactMatch}"
                                                                Background="#1976D2"
                                                                CornerRadius="3"
                                                                Margin="4,0,0,0"
                                                                Padding="4,1">
                                                            <TextBlock Text="Уже есть"
                                                                       FontSize="10"
                                                                       FontWeight="Bold"
                                                                       Foreground="White"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>

                                                <!-- Замена -->
                                                <Border Grid.Column="1"
                                                        Background="{Binding ReplacementBackground}"
                                                        BorderBrush="{Binding ReplacementBorderBrush}"
                                                        BorderThickness="{Binding ReplacementBorderThickness}"
                                                        CornerRadius="4"
                                                        Padding="6,3">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding Replacement}"
                                                                   FontWeight="{Binding ReplacementFontWeight}"
                                                                   Foreground="{Binding ReplacementForeground}"
                                                                   VerticalAlignment="Center"
                                                                   TextWrapping="Wrap"/>
                                                        <Border Grid.Column="1"
                                                                IsVisible="{Binding IsReplacementExactMatch}"
                                                                Background="#1976D2"
                                                                CornerRadius="3"
                                                                Margin="4,0,0,0"
                                                                Padding="4,1">
                                                            <TextBlock Text="Уже есть"
                                                                       FontSize="10"
                                                                       FontWeight="Bold"
                                                                       Foreground="White"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- Вкладка 2: Замена символов -->
                    <TabItem Header="Замена символов">
                        <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="6" Margin="0,6,0,0">
                            <!-- Форма ввода -->
                            <Grid Grid.Row="0" ColumnDefinitions="90,Auto,*,Auto,Auto" ColumnSpacing="6">
                                <TextBox Grid.Column="0"
                                         PlaceholderText="Символ"
                                         Text="{Binding TextBoxCharToFind}"/>
                                <Button Grid.Column="1"
                                        Content="✕"
                                        ToolTip.Tip="Очистить поля"
                                        Command="{Binding ButtonClearCharReplacementInputs}"
                                        VerticalAlignment="Center"
                                        Padding="8,5"/>
                                <TextBox Grid.Column="2"
                                         PlaceholderText="Замена всего слова"
                                         Text="{Binding TextBoxCharReplacementWord}"/>
                                <Button Grid.Column="3"
                                        Content="Добавить"
                                        Command="{Binding ButtonAddCharReplacement}"/>
                                <Button Grid.Column="4"
                                        Content="Удалить"
                                        Command="{Binding ButtonRemoveCharReplacement}"/>
                            </Grid>

                            <!-- Оповещение о совпадении -->
                            <Border Grid.Row="1"
                                    Background="#E3F2FD"
                                    BorderBrush="#2196F3"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="6,3"
                                    IsVisible="{Binding IsCharExactMatchFound}">
                                <TextBlock Text="Такой символ уже есть в правилах"
                                           Foreground="#1976D2"
                                           FontWeight="Bold"
                                           FontSize="12"/>
                            </Border>

                            <!-- Заголовки колонок -->
                            <Grid Grid.Row="2" ColumnDefinitions="90,*" ColumnSpacing="4">
                                <TextBlock Grid.Column="0" Text="Символ" FontWeight="SemiBold" Opacity="0.7" Margin="6,0"/>
                                <TextBlock Grid.Column="1" Text="Замена всего слова на" FontWeight="SemiBold" Opacity="0.7" Margin="6,0"/>
                            </Grid>

                            <!-- Список -->
                            <Border Grid.Row="3"
                                    BorderBrush="#E0E0E0" BorderThickness="1"
                                    CornerRadius="4"
                                    ClipToBounds="True">
                                <ListBox ItemsSource="{Binding FilteredCharWordReplacements}"
                                         SelectedItem="{Binding SelectedCharReplacementItem}"
                                         DoubleTapped="OnCharReplacementsDoubleTapped"
                                         MinHeight="280"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.IsScrollInertiaEnabled="True">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:WordReplacementItemViewModel">
                                            <Grid ColumnDefinitions="90,*" ColumnSpacing="4">
                                                <!-- Символ -->
                                                <Border Grid.Column="0"
                                                        Background="{Binding WordBackground}"
                                                        BorderBrush="{Binding WordBorderBrush}"
                                                        BorderThickness="{Binding WordBorderThickness}"
                                                        CornerRadius="4"
                                                        Padding="6,3">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding Word}"
                                                                   FontWeight="{Binding WordFontWeight}"
                                                                   Foreground="{Binding WordForeground}"
                                                                   VerticalAlignment="Center"
                                                                   TextWrapping="Wrap"/>
                                                        <Border Grid.Column="1"
                                                                IsVisible="{Binding IsWordExactMatch}"
                                                                Background="#1976D2"
                                                                CornerRadius="3"
                                                                Margin="4,0,0,0"
                                                                Padding="4,1">
                                                            <TextBlock Text="Уже есть"
                                                                       FontSize="10"
                                                                       FontWeight="Bold"
                                                                       Foreground="White"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>

                                                <!-- Замена -->
                                                <Border Grid.Column="1"
                                                        Background="{Binding ReplacementBackground}"
                                                        BorderBrush="{Binding ReplacementBorderBrush}"
                                                        BorderThickness="{Binding ReplacementBorderThickness}"
                                                        CornerRadius="4"
                                                        Padding="6,3">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding Replacement}"
                                                                   FontWeight="{Binding ReplacementFontWeight}"
                                                                   Foreground="{Binding ReplacementForeground}"
                                                                   VerticalAlignment="Center"
                                                                   TextWrapping="Wrap"/>
                                                        <Border Grid.Column="1"
                                                                IsVisible="{Binding IsReplacementExactMatch}"
                                                                Background="#1976D2"
                                                                CornerRadius="3"
                                                                Margin="4,0,0,0"
                                                                Padding="4,1">
                                                            <TextBlock Text="Уже есть"
                                                                       FontSize="10"
                                                                       FontWeight="Bold"
                                                                       Foreground="White"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- Вкладка 3: Чёрный список -->
                    <TabItem Header="Чёрный список">
                        <Grid RowDefinitions="Auto,*" RowSpacing="6" Margin="0,6,0,0">
                            <!-- Форма ввода -->
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                <TextBox Grid.Column="0"
                                         PlaceholderText="Никнейм пользователя"
                                         Text="{Binding TextBoxAddToBlackList}"/>
                                <Button Grid.Column="1"
                                        Content="Добавить"
                                        Command="{Binding ButtonAddToBlackList}"/>
                                <Button Grid.Column="2"
                                        Content="Удалить"
                                        Command="{Binding ButtonRemoveFromBlackList}"/>
                            </Grid>

                            <!-- Список -->
                            <Border Grid.Row="1"
                                    BorderBrush="#E0E0E0" BorderThickness="1"
                                    CornerRadius="4"
                                    ClipToBounds="True">
                                <ListBox ItemsSource="{Binding ListBoxItemSourceBlacklist}"
                                         SelectedItem="{Binding SelectedBlacklistItem}"
                                         MinHeight="280"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.IsScrollInertiaEnabled="True">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Padding="4,2" TextWrapping="Wrap"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Grid>
                    </TabItem>

                </TabControl>
            </Border>

        </Grid>
    </ScrollViewer>
</UserControl>